<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Everything Xcode can generate from INFOPLIST_KEY_* build settings still is:
  GENERATE_INFOPLIST_FILE stays YES and merges its keys into this file.

  This file exists only for keys that have no INFOPLIST_KEY_ equivalent.
  UIBackgroundModes is one of them — `INFOPLIST_KEY_UIBackgroundModes` is not a
  real build setting, and setting it is silently ignored rather than rejected.

  It lives in Config/ rather than VoleCast/ because VoleCast/ is a
  file-system-synchronized group, which would copy it into the bundle as a
  stray resource.
-->
<plist version="1.0">
<dict>
	<!-- Keeps audio playing when the app is backgrounded or the phone locks.
	     This is an Info.plist declaration, not an entitlement, so no
	     .entitlements file is needed. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- The car is a second scene, created by UIKit rather than by SwiftUI.
	     Only the CarPlay role is declared: SwiftUI goes on providing the
	     window scene from the App's WindowGroup.

	     This needs INFOPLIST_KEY_UIApplicationSceneManifest_Generation set
	     to NO, which it is. Left at YES, Xcode generates a manifest of its
	     own with an empty UISceneConfigurations, and the generated one wins
	     — the CarPlay role below is dropped from the built plist without a
	     word, and the car simply never offers the app. The failure looks
	     exactly like a delegate that was never called. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
