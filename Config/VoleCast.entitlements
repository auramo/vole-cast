<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One capability flag and nothing personal: no team, no bundle identifier.

  The entitlement itself is granted per Apple developer account, so a
  contributor without it can build for the simulator and run the tests but
  cannot sign a device build.

  It lives in Config/ rather than VoleCast/ for the same reason Info.plist
  does: VoleCast/ is a file-system-synchronized group, which would copy a
  stray file into the bundle as a resource.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>

	<!-- CloudKit, which mirrors the SwiftData store to the listener's own
	     private database. The identifier is parameterised: the pre-commit
	     hook rewrites it back whenever Xcode writes it out in full, which it
	     does every time the Signing & Capabilities pane is touched.

	     aps-environment is "development" here; distribution signing rewrites
	     it to production. CloudKit needs push to tell a device that another
	     one changed something. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(ORG_IDENTIFIER).VoleCast</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
