<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Capability flags and nothing personal: no team, no bundle identifier. The
  iCloud container is parameterised, and .githooks/pre-commit puts it back
  whenever Xcode writes it out in full — which it does every time the Signing
  & Capabilities pane is touched. Xcode also strips these comments each time,
  so if they are missing, that is what happened.

  This file lives in Config/ rather than VoleCast/ for the same reason
  Info.plist does: VoleCast/ is a file-system-synchronized group, which would
  copy a stray file into the bundle as a resource.
-->
<plist version="1.0">
<dict>
	<!-- Granted per Apple developer account. A contributor without it can
	     build for the simulator and run the tests but cannot sign a device
	     build. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>

	<!-- CloudKit mirrors the SwiftData store to the listener's own private
	     database. aps-environment is "development" here; distribution signing
	     rewrites it to production. Push is how one device learns that another
	     changed something. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(ORG_IDENTIFIER).VoleCast</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Added by Xcode alongside CloudKit and left alone: it is inert while
	     nothing here shares a record, and removing it only invites Xcode to
	     put it back the next time the pane is opened. -->
	<key>com.apple.developer.icloud-extended-share-access</key>
	<array/>
</dict>
</plist>
